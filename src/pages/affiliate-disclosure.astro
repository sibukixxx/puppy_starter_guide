---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Affiliate Disclosure"
  description="How Puppy Starter Guide uses affiliate links and how that may affect the content you read here."
>
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight text-stone-900">Affiliate Disclosure</h1>
    <div class="prose prose-stone mt-6 max-w-none">
      <p>
        Puppy Starter Guide may contain affiliate links to products, courses or services. If you
        click one of these links and make a purchase, we may earn a commission — at no
        additional cost to you.
      </p>
      <p>
        We only link to products or services we believe are genuinely useful for first-time
        puppy owners. Affiliate relationships never influence the factual content of our guides
        — training and care information is based on common, widely accepted practices, not on
        which products pay a commission.
      </p>
      <p>
        Articles that contain affiliate links include a short disclosure notice near the top of
        the page. If an article doesn't mention any products, it doesn't contain affiliate
        links.
      </p>
      <p>
        This disclosure is provided in accordance with FTC guidelines on affiliate marketing and
        endorsements. If you have questions about a specific link or recommendation, feel free to
        reach out.
      </p>
    </div>
  </div>
</BaseLayout>
