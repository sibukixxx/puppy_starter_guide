---
import BaseLayout from './BaseLayout.astro';
import DisclosureBanner from '../components/affiliate/DisclosureBanner.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  category: string;
  publishedAt: Date;
  updatedAt: Date;
  author: string;
  affiliate: boolean;
}

const { title, description, category, publishedAt, updatedAt, author, affiliate } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: author },
  datePublished: publishedAt.toISOString(),
  dateModified: updatedAt.toISOString(),
  mainEntityOfPage: canonicalUrl.toString(),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: new URL('/guides/', Astro.site).toString(),
    },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl.toString() },
  ],
};
---

<BaseLayout title={title} description={description} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-stone-500">
      <a href="/" class="hover:text-stone-700">Home</a>
      <span class="mx-1">/</span>
      <a href="/guides/" class="hover:text-stone-700">Guides</a>
      <span class="mx-1">/</span>
      <span class="text-stone-700">{title}</span>
    </nav>

    <p class="text-sm font-medium uppercase tracking-wide text-amber-700">{category}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">{title}</h1>
    <p class="mt-4 text-sm text-stone-500">
      Published {formatDate(publishedAt)} · Updated {formatDate(updatedAt)}
    </p>

    {affiliate && (
      <div class="mt-6">
        <DisclosureBanner />
      </div>
    )}

    <div
      class="prose prose-stone mt-8 max-w-none prose-headings:font-semibold prose-a:text-amber-700"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
